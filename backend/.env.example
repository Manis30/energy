# Industrial Energy Intelligence Platform - Backend Environment Template

APP_ENV=development
APP_NAME="Industrial Energy Intelligence Platform"

# Neon PostgreSQL Database
DATABASE_URL=postgresql://user:password@ep-sample-a1arlm2b.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@ep-sample-a1arlm2b-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
READONLY_DATABASE_URL=postgresql://user:password@ep-sample-a1arlm2b.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Domo AI Services
DOMO_BASE_URL=https://gwcteq-partner.domo.com
DOMO_DEVELOPER_TOKEN=your_domo_developer_token_here
MODEL_NAME=domo.domo_ai.domogpt-large-v2.2:anthropic
DOMO_TIMEOUT_SECONDS=30.0
DOMO_MAX_RETRIES=3

# Frontend Client URL / CORS Configuration
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

